# Les Clés de la Réussite — configuration Apache (Hostinger, hébergement mutualisé/code classique)
# À adapter si l'hébergement définitif diffère (voir note de livraison : Hostinger Website Builder vs hébergement fichiers/PHP).

RewriteEngine On

# --- Migration depuis l'ancien site (Hostinger Website Builder) ---
Redirect 301 /about /a-propos
Redirect 301 /privacy-policy /politique-confidentialite
Redirect 301 /terms-and-conditions /mentions-legales

# --- Page retirée définitivement (ancienne page "Nos logements") ---
# Statut 410 Gone : contenu volontairement et définitivement retiré, pas de remplacement équivalent.
RewriteRule ^nos-logements/?$ - [G,L]
ErrorDocument 410 /nos-logements/index.html

# --- URL canoniques sans barre finale (/tarifs et non /tarifs/) ---
# Par défaut Apache redirige /tarifs vers /tarifs/ ; on garde au contraire l'URL sans slash,
# cohérente avec les balises canonical, le sitemap et les anciennes URL (/nos-services).
DirectorySlash Off
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# --- HTTPS et domaine unique : à activer une fois le certificat SSL et le domaine définitifs confirmés ---
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://lesclesdelareussite-conciergerie.com/$1 [R=301,L]
# RewriteCond %{HTTP_HOST} ^www. [NC]
# RewriteRule ^(.*)$ https://lesclesdelareussite-conciergerie.com/$1 [R=301,L]

# --- Page 404 personnalisée ---
ErrorDocument 404 /404.html

# --- Sécurité de base ---
Options -Indexes
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Compression et cache (facultatif mais recommandé en production) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json application/ld+json text/plain text/xml application/xml image/svg+xml
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType text/plain .txt

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
